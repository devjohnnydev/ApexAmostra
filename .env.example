# Configurações do Servidor
PORT=3000
NODE_ENV=production

# Banco de Dados (MySQL)
# Substitua com as credenciais do seu banco gerenciado na Railway ou na Hostinger
DB_HOST=127.0.0.1
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=seu_banco

# Autenticação e JWT
# Gere um texto longo e aleatório para servir de chave de segurança dos tokens de login
JWT_SECRET=super_secret_jwt_key_aqui

# Integração Resend (Envio de E-mails)
# Crie uma conta no resend.com, verifique seu domínio (Hostinger) lá, e pegue a API Key.
RESEND_API_KEY=re_sua_api_key_aqui

# Endereço de e-mail remetente
# Precisa ser um e-mail com o domínio verificado no Resend.
# Exemplo se o domínio for apextechmetais.com.br
RESEND_FROM=sistema@apextechmetais.com.br

# Segurança de Cron/Gatilhos externos (Opcional, usado se for acionar cron via URL)
CRON_SECRET=minha_senha_secreta_para_cron
